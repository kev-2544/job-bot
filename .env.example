# Copy to .env for local runs (never commit .env). In GitHub Actions these
# come from repository secrets instead.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (defaults to Gmail SSL on port 465 with an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=you@gmail.com
# Comma-separated for multiple recipients
EMAIL_TO=you@gmail.com

# --- Job sources (sources with missing keys are skipped with a warning) ---
JOOBLE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Optional LLM eligibility check (filters.llm.enabled in config.yaml) ---
ANTHROPIC_API_KEY=

# --- Optional overrides ---
# JOBBOT_CONFIG=config.yaml
# LOG_LEVEL=INFO
